{
  "compilerOptions": {
    "lib": ["es2019", "es2020", "dom"],
    "module": "CommonJS",
    "target": "ES2019",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": false
  },
  "exclude": ["node_modules", "build", "dist", ".cache"]
}